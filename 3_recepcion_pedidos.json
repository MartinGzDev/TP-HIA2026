    },
    {
      "id": "e70a970d-907f-4b9d-8a05-697de2fefd9f",
      "name": "Validar datos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst errores = [];\nif (!b.clienteId || !Number.isInteger(Number(b.clienteId)) || Number(b.clienteId) <= 0) errores.push('clienteId debe ser un entero positivo');\nif (!b.direccionEntrega || String(b.direccionEntrega).trim().length < 5) errores.push('direccionEntrega es obligatoria (minimo 5 caracteres)');\nconst pagos = ['Tarjeta de Crédito','Tarjeta de Débito','Efectivo','Transferencia','Mercado Pago','Otro'];\nif (!pagos.includes(b.metodoPago)) errores.push('metodoPago invalido');\nconst total = Number(b.total);\nif (!Number.isFinite(total) || total <= 0) errores.push('total debe ser un numero mayor a 0');\nreturn [{ json: { valido: errores.length === 0, errores,\n  clienteId: Number(b.clienteId), direccionEntrega: String(b.direccionEntrega || '').trim(),\n  metodoPago: b.metodoPago, total } }];"
      }
    },
    {
      "id": "0d03a966-6e4b-4ecb-8b2a-c031f8e65fb5",
      "name": "¿Datos validos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "0d1b68b1-c94a-469f-a530-408fcf322b48",
              "leftValue": "={{ $json.valido }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "58064054-51d2-4dcd-a040-75c5ad15de57",
      "name": "Guardar (BD, escritura)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        720,
        -80
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=CREATE TABLE IF NOT EXISTS n8n_pedidos_externos (id SERIAL PRIMARY KEY, cliente_id INT NOT NULL, direccion_entrega TEXT NOT NULL, metodo_pago TEXT NOT NULL, total NUMERIC(12,2) NOT NULL, recibido_en TIMESTAMPTZ NOT NULL DEFAULT now()); INSERT INTO n8n_pedidos_externos (cliente_id, direccion_entrega, metodo_pago, total) VALUES ({{ $json.clienteId }}, '{{ $json.direccionEntrega.replace(/'/g, \"''\") }}', '{{ $json.metodoPago }}', {{ $json.total }}) RETURNING id;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres HIA14 escritura"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
